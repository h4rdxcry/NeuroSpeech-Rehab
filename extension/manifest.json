{
  "manifest_version": 3,
  "name": "NeuroSpeech Companion — Speech Rehabilitation",
  "short_name": "NeuroSpeech",
  "version": "1.0.0",
  "description": "AI-Based Speech Rehabilitation companion with quick articulatory drills, API health checks, and therapy launcher.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
