# 1. Database Connection (Supabase Cloud PostgreSQL)
# Get from: Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI / Node.js
# Note: Using port 6543 (Pooler) or 5432 (Direct)
DATABASE_URL=postgresql+asyncpg://postgres.tmdqmbrnbuikzmtbkntk:YOUR_SUPABASE_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# 2. Environment Runtime
ENVIRONMENT=production

# 3. Security Tokens (HS256 JWT, min 32 chars)
JWT_SECRET=neurospeech_rehab_production_jwt_secret_secure_key_2026_default_safe
JWT_REFRESH_SECRET=neurospeech_rehab_production_refresh_secret_key_2026_safe

# 4. Allowed Frontend CORS Origins (comma separated)
CORS_ORIGINS=https://neuro-speech-rehab.vercel.app,http://localhost:5173,http://localhost:3000

# 5. Supabase Public & Service Keys (Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://tmdqmbrnbuikzmtbkntk.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
